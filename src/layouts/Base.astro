---
import Announcements from "../components/Announcements.astro";
import { active } from "../lib/announcements.js";
import { canCoach } from "../lib/auth.js";
import { club } from "../lib/config.js";
import { blobsStore } from "../lib/store.js";

interface Props {
  title: string;
}

const { title } = Astro.props;
const role = Astro.locals.role;
const path = Astro.url.pathname;
const { colors } = club;

// Club colors from club.json become CSS variables. They're validated hex values,
// so writing them into a style tag is safe.
const clubCss = `
:root {
  --brand: ${colors.primary};
  --brand-2: ${colors.secondary};
  --brand-3: ${colors.accent};
  --chart-strong: ${colors.chart.light.strong};
  --chart-muted: ${colors.chart.light.muted};
}
@media (prefers-color-scheme: dark) {
  :root {
    --chart-strong: ${colors.chart.dark.strong};
    --chart-muted: ${colors.chart.dark.muted};
  }
}`;

const links = [
  { href: "/", label: "Season" },
  { href: "/notifications", label: "Alerts" },
  { href: "/guide", label: "Rowing 101" },
  ...(canCoach(role) ? [{ href: "/coach", label: "Coach" }] : []),
  ...(role === "admin" ? [{ href: "/admin", label: "Admin" }] : []),
];
// Logged-in pages show current announcements at the top.
const announcements = role ? active(await blobsStore().getAnnouncements()) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · CrewDash</title>
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/png" href="/icons/icon-192.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="theme-color" content={colors.primary} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <!-- The navy header runs up under the status bar. Its padding below keeps content clear of it. -->
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <style is:inline set:html={clubCss} />
  </head>
  <body>
    <header class="site">
      <div class="bar">
        <a class="brand" href="/">
          <span class="crest" aria-hidden="true">
            {club.name.charAt(0)}
          </span>
          <span>{club.name}</span>
        </a>
        {role && (
          <nav>
            {links.map((l) => (
              <a href={l.href} aria-current={path === l.href ? "page" : undefined}>
                {l.label}
              </a>
            ))}
            <form method="post" action="/api/logout">
              <button type="submit" class="link">
                Log out
              </button>
            </form>
          </nav>
        )}
      </div>
      <div class="stripes" aria-hidden="true"></div>
    </header>
    <main>
      <Announcements announcements={announcements} />
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f4f5f9;
    --surface: #ffffff;
    --surface-2: #eef1f8;
    --text: #121a33;
    --muted: #5a6175;
    --border: #dde1ea;
    --link: #2c4a9e;
    --warn: #8a4b00;
    --button: var(--brand);
    --button-text: #ffffff;
    --medal-gold-bg: #fbe7a1;
    --medal-gold-text: #5a4300;
    --medal-silver-bg: #e3e7ee;
    --medal-silver-text: #39424f;
    --medal-bronze-bg: #f1cfae;
    --medal-bronze-text: #5b3410;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0c1124;
      --surface: #141a2e;
      --surface-2: #1b2340;
      --text: #e9ecf5;
      --muted: #a2a9bd;
      --border: #263050;
      --link: #f4c64a;
      --warn: #e5a660;
      --button: var(--brand-3);
      --button-text: #0e1a45;
      --medal-gold-bg: #5c4708;
      --medal-gold-text: #ffe08a;
      --medal-silver-bg: #3a4252;
      --medal-silver-text: #e6eaf1;
      --medal-bronze-bg: #5a3518;
      --medal-bronze-text: #f6cfa6;
    }
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font:
      16px/1.45 system-ui,
      -apple-system,
      "Segoe UI",
      sans-serif;
  }
  header.site {
    background: var(--brand);
    color: #ffffff;
  }
  header.site .bar {
    max-width: 960px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    /* Clear the phone's status bar, notch and rounded corners when installed. */
    padding: calc(12px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) 12px
      calc(16px + env(safe-area-inset-left));
  }
  /* The sleeve stripes from the club uniform. */
  .stripes {
    height: 10px;
    background: linear-gradient(var(--brand-2) 0 50%, var(--brand-3) 50% 100%);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: 0.01em;
    color: #ffffff;
    text-decoration: none;
  }
  .crest {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--brand-3);
    color: var(--brand);
    font-weight: 900;
  }
  header.site nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
  }
  header.site nav a,
  header.site nav .link {
    color: #ffffff;
    text-decoration: none;
    padding: 6px 10px;
    border-radius: 999px;
    font-size: 0.95rem;
  }
  header.site nav a:hover,
  header.site nav .link:hover {
    background: rgb(255 255 255 / 0.12);
  }
  header.site nav a[aria-current="page"] {
    background: var(--brand-3);
    color: var(--brand);
    font-weight: 700;
  }
  header.site nav form {
    margin: 0;
  }
  main {
    max-width: 960px;
    margin: 0 auto;
    padding: 16px calc(16px + env(safe-area-inset-right)) calc(16px + env(safe-area-inset-bottom))
      calc(16px + env(safe-area-inset-left));
  }
  a {
    color: var(--link);
  }
  a.plain {
    color: inherit;
    text-decoration: none;
  }
  label {
    display: block;
    margin-bottom: 4px;
  }
  h1 {
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    margin: 12px 0 4px;
  }
  h2 {
    font-size: 1.1rem;
    font-weight: 750;
    margin: 0;
  }
  .eyebrow {
    margin: 8px 0 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .muted {
    color: var(--muted);
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 14px 16px;
    margin: 12px 0;
    box-shadow: 0 1px 2px rgb(14 26 69 / 0.06);
  }
  a.card {
    transition:
      transform 120ms ease,
      box-shadow 120ms ease;
  }
  a.card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgb(14 26 69 / 0.12);
  }
  .notice {
    border-left: 4px solid var(--warn);
  }
  .medal {
    display: inline-block;
    padding: 1px 9px;
    border-radius: 999px;
    font-weight: 800;
    font-size: 0.9rem;
    background: var(--surface-2);
    color: var(--text);
  }
  .medal.gold {
    background: var(--medal-gold-bg);
    color: var(--medal-gold-text);
  }
  .medal.silver {
    background: var(--medal-silver-bg);
    color: var(--medal-silver-text);
  }
  .medal.bronze {
    background: var(--medal-bronze-bg);
    color: var(--medal-bronze-text);
  }
  button,
  input,
  select {
    font: inherit;
  }
  button {
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--button);
    background: var(--button);
    color: var(--button-text);
    font-weight: 700;
    cursor: pointer;
  }
  button.secondary {
    background: transparent;
    color: var(--link);
    border-color: var(--link);
  }
  button.link {
    padding: 0;
    border: 0;
    background: none;
    color: var(--link);
    font-weight: inherit;
    text-decoration: underline;
  }
  input[type="text"],
  input[type="password"],
  select {
    width: 100%;
    padding: 10px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--text);
  }
  details.table-view summary {
    cursor: pointer;
    color: var(--link);
    font-size: 0.9rem;
  }
  details.table-view table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 8px;
    font-variant-numeric: tabular-nums;
  }
  details.table-view th,
  details.table-view td {
    text-align: left;
    padding: 4px 6px;
    border-bottom: 1px solid var(--border);
  }
</style>
