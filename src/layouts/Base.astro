---
import Announcements from "../components/Announcements.astro";
import Blade from "../components/Blade.astro";
import { active } from "../lib/announcements.js";
import { canCoach } from "../lib/auth.js";
import { club } from "../lib/config.js";
import { blobsStore } from "../lib/store.js";

interface Props {
  title: string;
}

const { title } = Astro.props;
const role = Astro.locals.role;
const path = Astro.url.pathname;
const { colors } = club;

// Club colors from club.json become CSS variables. They're validated hex values,
// so writing them into a style tag is safe.
const clubCss = `
:root {
  --brand: ${colors.primary};
  --brand-2: ${colors.secondary};
  --brand-3: ${colors.accent};
  --chart-strong: ${colors.chart.light.strong};
  --chart-muted: ${colors.chart.light.muted};
}
@media (prefers-color-scheme: dark) {
  :root {
    --chart-strong: ${colors.chart.dark.strong};
    --chart-muted: ${colors.chart.dark.muted};
  }
}`;

const links = [
  { href: "/", label: "Season" },
  { href: "/rowers", label: "Following" },
  { href: "/venues", label: "Venues" },
  { href: "/guide", label: "Rowing 101" },
  ...(canCoach(role) ? [{ href: "/coach", label: "Coach" }] : []),
  ...(role === "admin" ? [{ href: "/admin", label: "Admin" }] : []),
];
// Logged-in pages show current announcements at the top, and the bell gets a dot when an
// alert is newer than this phone last looked.
const store = blobsStore();
const [allAnnouncements, alertLog] = role
  ? await Promise.all([store.getAnnouncements(), store.getAlertLog().catch(() => [])])
  : [[], []];
const announcements = active(allAnnouncements);
const latestAlert = alertLog[0]?.at ?? "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · CrewDash</title>
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/png" href="/icons/icon-192.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="theme-color" content={colors.primary} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <!-- The navy header runs up under the status bar. Its padding below keeps content clear of it. -->
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <style is:inline set:html={clubCss} />
  </head>
  <body>
    <header class="site">
      <div class="bar">
        <a class="brand" href="/">
          <span class="crest" aria-hidden="true">
            {club.name.charAt(0)}
          </span>
          <span>{club.name}</span>
          <Blade width={44} />
        </a>
        {role && (
          <nav>
            {links.map((l) => (
              <a href={l.href} aria-current={path === l.href ? "page" : undefined}>
                {l.label}
              </a>
            ))}
          </nav>
        )}
        {role && (
          <a
            class="bell"
            href="/alerts"
            aria-label="Recent alerts"
            aria-current={path === "/alerts" ? "page" : undefined}
            data-latest={latestAlert}
          >
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
              <path
                fill="currentColor"
                d="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22zm7-6V11a7 7 0 0 0-5.5-6.84V3.5a1.5 1.5 0 0 0-3 0v.66A7 7 0 0 0 5 11v5l-2 2v1h18v-1z"
              />
            </svg>
            <span class="dot" hidden></span>
          </a>
        )}
        {role && (
          <details class="settings">
            <summary aria-label="Settings">
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M19.4 13a7.5 7.5 0 0 0 0-2l2.1-1.6-2-3.5-2.5 1a7.3 7.3 0 0 0-1.7-1L15 3h-4l-.3 2.9a7.3 7.3 0 0 0-1.7 1l-2.5-1-2 3.5L6.6 11a7.5 7.5 0 0 0 0 2l-2.1 1.6 2 3.5 2.5-1c.5.4 1.1.7 1.7 1L11 21h4l.3-2.9c.6-.3 1.2-.6 1.7-1l2.5 1 2-3.5zM13 15.5a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7z"
                  transform="translate(-1 0)"
                />
              </svg>
            </summary>
            <div class="menu">
              <a
                href="/notifications"
                aria-current={path === "/notifications" ? "page" : undefined}
              >
                Alerts
              </a>
              <form method="post" action="/api/logout">
                <button type="submit" class="link">
                  Log out
                </button>
              </form>
            </div>
          </details>
        )}
      </div>
      <div class="stripes" aria-hidden="true"></div>
    </header>
    <main>
      <Announcements announcements={announcements} />
      <slot />
    </main>
    <script>
      // The bell's dot: an alert newer than the last visit to /alerts on this phone.
      const bell = document.querySelector<HTMLElement>(".bell");
      const latest = bell?.dataset.latest;
      if (bell && latest) {
        let seen = "";
        try {
          seen = localStorage.getItem("crewdash-alerts-seen") ?? "";
        } catch {
          // No storage: show the dot.
        }
        const dot = bell.querySelector<HTMLElement>(".dot");
        if (dot && latest > seen && location.pathname !== "/alerts") dot.hidden = false;
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f4f5f9;
    --surface: #ffffff;
    --surface-2: #eef1f8;
    --text: #121a33;
    --muted: #5a6175;
    --border: #dde1ea;
    --link: #2c4a9e;
    --warn: #8a4b00;
    --button: var(--brand);
    --button-text: #ffffff;
    --medal-gold-bg: #fbe7a1;
    --medal-gold-text: #5a4300;
    --medal-silver-bg: #e3e7ee;
    --medal-silver-text: #39424f;
    --medal-bronze-bg: #f1cfae;
    --medal-bronze-text: #5b3410;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0c1124;
      --surface: #141a2e;
      --surface-2: #1b2340;
      --text: #e9ecf5;
      --muted: #a2a9bd;
      --border: #263050;
      --link: #f4c64a;
      --warn: #e5a660;
      --button: var(--brand-3);
      --button-text: #0e1a45;
      --medal-gold-bg: #5c4708;
      --medal-gold-text: #ffe08a;
      --medal-silver-bg: #3a4252;
      --medal-silver-text: #e6eaf1;
      --medal-bronze-bg: #5a3518;
      --medal-bronze-text: #f6cfa6;
    }
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font:
      16px/1.45 system-ui,
      -apple-system,
      "Segoe UI",
      sans-serif;
  }
  header.site {
    background: var(--brand);
    color: #ffffff;
  }
  header.site .bar {
    max-width: 960px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    /* Clear the phone's status bar, notch and rounded corners when installed. */
    padding: calc(12px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) 12px
      calc(16px + env(safe-area-inset-left));
  }
  /* The sleeve stripes from the club uniform. */
  .stripes {
    height: 10px;
    background: linear-gradient(var(--brand-2) 0 50%, var(--brand-3) 50% 100%);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: 0.01em;
    color: #ffffff;
    text-decoration: none;
  }
  .crest {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--brand-3);
    color: var(--brand);
    font-weight: 900;
  }
  header.site nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
  }
  header.site nav a,
  header.site nav .link {
    color: #ffffff;
    text-decoration: none;
    padding: 6px 10px;
    border-radius: 999px;
    font-size: 0.95rem;
  }
  header.site nav a:hover,
  header.site nav .link:hover {
    background: rgb(255 255 255 / 0.12);
  }
  header.site nav a[aria-current="page"] {
    background: var(--brand-3);
    color: var(--brand);
    font-weight: 700;
  }
  /* Alerts and Log out sit behind a gear at the top right. */
  header.site nav {
    margin-left: auto;
  }
  .settings {
    position: relative;
  }
  /* The bell sits just left of the gear. */
  .bell {
    position: relative;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-right: -12px;
    border-radius: 999px;
    color: #ffffff;
  }
  .bell:hover,
  .bell[aria-current="page"] {
    background: rgb(255 255 255 / 0.12);
  }
  .bell .dot {
    position: absolute;
    top: 8px;
    right: 9px;
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--brand-3);
    box-shadow: 0 0 0 2px var(--brand);
  }
  .settings summary {
    list-style: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    color: #ffffff;
    cursor: pointer;
  }
  .settings summary::-webkit-details-marker {
    display: none;
  }
  .settings summary:hover,
  .settings[open] summary {
    background: rgb(255 255 255 / 0.12);
  }
  .settings .menu {
    position: absolute;
    right: 0;
    top: calc(100% + 6px);
    z-index: 20;
    min-width: 160px;
    padding: 6px;
    border-radius: 12px;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: 0 8px 24px rgb(14 26 69 / 0.18);
    display: flex;
    flex-direction: column;
  }
  .settings .menu a,
  .settings .menu .link {
    display: block;
    width: 100%;
    text-align: left;
    padding: 10px 12px;
    border-radius: 8px;
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
  }
  .settings .menu a:hover,
  .settings .menu .link:hover {
    background: var(--surface-2);
  }
  .settings .menu form {
    margin: 0;
  }
  /* On phones the gear stays beside the club name and the links take the next row. */
  @media (max-width: 640px) {
    header.site nav {
      order: 3;
      flex-basis: 100%;
      margin-left: 0;
    }
    .bell {
      margin-left: auto;
    }
  }
  main {
    max-width: 960px;
    margin: 0 auto;
    padding: 16px calc(16px + env(safe-area-inset-right)) calc(16px + env(safe-area-inset-bottom))
      calc(16px + env(safe-area-inset-left));
  }
  a {
    color: var(--link);
  }
  a.plain {
    color: inherit;
    text-decoration: none;
  }
  label {
    display: block;
    margin-bottom: 4px;
  }
  h1 {
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    margin: 12px 0 4px;
  }
  h2 {
    font-size: 1.1rem;
    font-weight: 750;
    margin: 0;
  }
  .eyebrow {
    margin: 8px 0 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .muted {
    color: var(--muted);
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 14px 16px;
    margin: 12px 0;
    box-shadow: 0 1px 2px rgb(14 26 69 / 0.06);
  }
  a.card {
    transition:
      transform 120ms ease,
      box-shadow 120ms ease;
  }
  a.card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgb(14 26 69 / 0.12);
  }
  .notice {
    border-left: 4px solid var(--warn);
  }
  .medal {
    display: inline-block;
    padding: 1px 9px;
    border-radius: 999px;
    font-weight: 800;
    font-size: 0.9rem;
    background: var(--surface-2);
    color: var(--text);
  }
  .medal.gold {
    background: var(--medal-gold-bg);
    color: var(--medal-gold-text);
  }
  .medal.silver {
    background: var(--medal-silver-bg);
    color: var(--medal-silver-text);
  }
  .medal.bronze {
    background: var(--medal-bronze-bg);
    color: var(--medal-bronze-text);
  }
  button,
  input,
  select {
    font: inherit;
  }
  button {
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--button);
    background: var(--button);
    color: var(--button-text);
    font-weight: 700;
    cursor: pointer;
  }
  button.secondary {
    background: transparent;
    color: var(--link);
    border-color: var(--link);
  }
  button.link {
    padding: 0;
    border: 0;
    background: none;
    color: var(--link);
    font-weight: inherit;
    text-decoration: underline;
  }
  input[type="text"],
  input[type="password"],
  select {
    width: 100%;
    padding: 10px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--text);
  }
  details.table-view summary {
    cursor: pointer;
    color: var(--link);
    font-size: 0.9rem;
  }
  details.table-view table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 8px;
    font-variant-numeric: tabular-nums;
  }
  details.table-view th,
  details.table-view td {
    text-align: left;
    padding: 4px 6px;
    border-bottom: 1px solid var(--border);
  }
</style>
