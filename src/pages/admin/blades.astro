---
import Blade from "../../components/Blade.astro";
import BladeFields from "../../components/BladeFields.astro";
import Base from "../../layouts/Base.astro";
import { bladeFor, otherClubs } from "../../lib/blades.js";
import { loadContext } from "../../lib/context.js";

const error = Astro.url.searchParams.get("error");
const { store, records, club } = await loadContext();
const blades = await store.getBlades();
// Clubs in the results, most entries first, plus any saved club not raced lately.
const seen = otherClubs(records, club);
const clubs = [
  ...seen,
  ...blades.clubs
    .filter((b) => !seen.some((s) => bladeFor(s.name, { clubs: [b] }, club)))
    .map((b) => ({ name: b.name, entries: 0 })),
];
---

<Base title="Blades">
  <p class="eyebrow">
    <a href="/admin">Admin</a>
  </p>
  <h1>Other clubs' blades</h1>
  <p class="muted">
    Blades show next to each crew in a regatta's "whole field" list. Build each club's blade from a
    color and up to three shapes, as close to the real one as you can. Check the club's website or
    racing photos. Don't copy images from OarSpotter, which asked us not to use theirs.
  </p>
  {error && <p class="card notice">{error}</p>}
  {clubs.length === 0 && <p class="card">Add a regatta first. Its clubs will appear here.</p>}
  {clubs.map(({ name, entries }) => {
    const design = bladeFor(name, blades, club);
    const saved = design !== null;
    return (
      <form method="post" action="/api/admin/blades" class="card blade-row">
        <input type="hidden" name="name" value={name} />
        <div class="who">
          {design ? (
            <Blade width={56} design={design} onBrand={false} compact />
          ) : (
            <span class="muted small">No blade yet</span>
          )}
          <strong>{name}</strong>
          {entries > 0 && (
            <span class="muted small">
              {entries} {entries === 1 ? "entry" : "entries"}
            </span>
          )}
        </div>
        <details>
          <summary>{saved ? "Change blade" : "Add blade"}</summary>
          <BladeFields design={design} />
          <div class="row">
            <button type="submit" name="action" value="save">
              Save
            </button>
            {saved && (
              <button type="submit" name="action" value="remove" class="secondary">
                Remove
              </button>
            )}
          </div>
        </details>
      </form>
    );
  })}
</Base>

<style>
  .blade-row .who {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin-bottom: 8px;
  }
  .blade-row .row {
    display: flex;
    gap: 8px 12px;
    margin-top: 12px;
  }
</style>
