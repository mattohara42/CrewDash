---
import BladeRow from "../../components/BladeRow.astro";
import Base from "../../layouts/Base.astro";
import { safeNext } from "../../lib/auth.js";
import { bladeFor, crewClub, findClub, otherClubs, sameClub } from "../../lib/blades.js";
import { loadContext } from "../../lib/context.js";

const params = Astro.url.searchParams;
const error = params.get("error");
// A whole-field list links here with ?club= to edit one club, and ?back= to return to it.
const focus = params.get("club")?.trim() || null;
const back = safeNext(params.get("back"), "/admin/blades");
const { store, records, club } = await loadContext();
const blades = await store.getBlades();
// Clubs in the results, most entries first, plus any saved club not raced lately.
const seen = otherClubs(records, club, blades);
const clubs = [
  ...seen,
  ...blades.clubs
    .filter((b) => !seen.some((s) => sameClub(s.name, b.name)))
    .map((b) => ({ name: b.name, entries: 0 })),
].map((c) => {
  const saved = findClub(blades, c.name);
  return { ...c, design: saved?.design ?? null, aliases: saved?.aliases ?? [] };
});
const focusName = focus ? (findClub(blades, focus)?.name ?? crewClub(focus)) : null;
const focused = focusName
  ? (clubs.find((c) => sameClub(c.name, focusName)) ?? {
      name: focusName,
      entries: 0,
      design: bladeFor(focusName, blades, club),
      aliases: [],
    })
  : null;
const needed = clubs.filter((c) => !c.design);
const done = clubs.filter((c) => c.design);
---

<Base title="Blades">
  <p class="eyebrow">
    <a href="/admin">Admin</a>
  </p>
  <h1>Other clubs' blades</h1>
  <p class="muted">
    Blades show next to each crew in a regatta's "whole field" list. Build each club's blade from a
    color and up to three shapes, as close to the real one as you can. Check the club's website or
    racing photos. Don't copy images from OarSpotter, which asked us not to use theirs.
  </p>
  {error && <p class="card notice">{error}</p>}
  <datalist id="blade-club-names">
    {clubs.map((c) => (
      <option value={c.name} />
    ))}
  </datalist>
  {focused ? (
    <>
      <BladeRow {...focused} back={back} open />
      <p>
        <a href="/admin/blades">Show all clubs</a>
      </p>
    </>
  ) : clubs.length === 0 ? (
    <p class="card">Add a regatta first. Its clubs will appear here.</p>
  ) : (
    <>
      <label class="search">
        Find a club
        <input type="search" data-blade-search autocomplete="off" placeholder="Club name" />
      </label>
      <p class="muted" data-blade-none hidden>
        No clubs match.
      </p>
      {[
        { title: "Needs a blade", list: needed },
        { title: "Has a blade", list: done },
      ].map(({ title, list }) =>
        list.length === 0 ? null : (
          <section data-blade-group>
            <h2>
              {title} <span class="muted small">({list.length})</span>
            </h2>
            {list.map((c) => (
              <BladeRow {...c} back="/admin/blades" />
            ))}
          </section>
        ),
      )}
    </>
  )}
</Base>

<script>
  // Filters the list as you type. The search is kept in the address, so saving a club
  // comes back to the same search.
  const input = document.querySelector<HTMLInputElement>("[data-blade-search]");
  const none = document.querySelector<HTMLElement>("[data-blade-none]");
  // Ignores case, spacing and punctuation, so "st josephs" finds "St. Joseph's".
  const loose = (s: string) => s.toLowerCase().replace(/[^a-z0-9]/g, "");
  const filter = () => {
    if (!input) return;
    const q = loose(input.value);
    let shown = 0;
    document.querySelectorAll<HTMLElement>("[data-blade-group]").forEach((group) => {
      let inGroup = 0;
      group.querySelectorAll<HTMLElement>("[data-club]").forEach((row) => {
        const match = loose(row.dataset.club ?? "").includes(q);
        row.hidden = !match;
        if (match) inGroup++;
      });
      group.hidden = inGroup === 0;
      shown += inGroup;
    });
    if (none) none.hidden = shown > 0;
    const url = new URL(location.href);
    if (input.value.trim()) url.searchParams.set("q", input.value.trim());
    else url.searchParams.delete("q");
    url.searchParams.delete("error");
    history.replaceState(null, "", url);
    const back = url.pathname + url.search;
    document
      .querySelectorAll<HTMLInputElement>('[data-blade-group] input[name="back"]')
      .forEach((el) => (el.value = back));
  };
  if (input) {
    input.value = new URLSearchParams(location.search).get("q") ?? "";
    input.addEventListener("input", filter);
    filter();
  }
</script>

<style>
  .search {
    display: grid;
    gap: 4px;
    margin: 16px 0;
  }
  .search input {
    font-size: 1rem;
    padding: 8px 10px;
  }
  .small {
    font-size: 0.85rem;
    font-weight: normal;
  }
</style>
