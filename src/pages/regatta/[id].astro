---
import BoatList from "../../components/BoatList.astro";
import NoteBox from "../../components/NoteBox.astro";
import StatTiles from "../../components/StatTiles.astro";
import ConditionsLine from "../../components/ConditionsLine.astro";
import VenueCard from "../../components/VenueCard.astro";
import Base from "../../layouts/Base.astro";
import { clubEvents, clubSummary } from "../../lib/club-view.js";
import { loadContext } from "../../lib/context.js";
import { formatDate, formatStart } from "../../lib/format.js";
import { regattaYear, regattasInSeries, seriesKey, seriesName } from "../../lib/history.js";
import { isRecent } from "../../lib/refresh.js";
import { eventKey } from "../../lib/settings.js";
import { venueForSeries } from "../../lib/venues.js";
import { regattaConditions } from "../../lib/conditions.js";
import { localDate } from "../../lib/today.js";
import { canCoach } from "../../lib/auth.js";

const { store, records, settings, club } = await loadContext();
const record = records.find((r) => r.regatta.id === Astro.params.id);
if (!record) return new Response("Regatta not found", { status: 404 });

const { regatta, fetchedAt } = record;
const events = clubEvents(regatta, club);
const summary = clubSummary(events);
const year = regattaYear(regatta);
const series = seriesName(record);
const notes = await store.getNotes(regatta.id);
const canNote = canCoach(Astro.locals.role);
const back = `/regatta/${regatta.id}`;
const venue = venueForSeries(await store.getVenues(), series);
const conditions = await regattaConditions(record, venue, store.conditions, {
  timeZone: club.timezone,
  units: club.units,
  today: localDate(new Date(), club.timezone),
});
const otherYears = regattasInSeries(records, seriesKey(series)).length > 1;
const updated = new Date(fetchedAt).toLocaleString("en-US", {
  dateStyle: "medium",
  timeStyle: "short",
  timeZone: club.timezone,
});
---

<Base title={regatta.title}>
  <h1>{regatta.title}</h1>
  <p class="muted">
    {formatDate(regatta.date)} · Results fetched {updated} ET ·{" "}
    <a href={`https://www.crewtimer.com/regatta/${regatta.id}`}>Full results on CrewTimer</a> ·{" "}
    <a href={`/recap?id=${regatta.id}`}>Weekend recap</a> ·{" "}
    <a href={`/api/calendar?id=${regatta.id}`}>Add to calendar</a>
  </p>
  {otherYears && (
    <p>
      <a href={`/series?${new URLSearchParams({ name: series })}`}>
        Compare with other years of {series}
      </a>
    </p>
  )}
  {conditions && (
    <ConditionsLine conditions={conditions} courseBearing={venue?.courseBearing ?? null} />
  )}
  {venue && <VenueCard venue={venue} />}
  {isRecent(regatta.date) && <p class="card notice">Results may still change.</p>}
  {events.length > 0 && (
    <StatTiles
      tiles={[
        { label: "Events", value: events.length },
        { label: "Boats", value: summary.boats },
        { label: "Wins", value: summary.wins },
        { label: "Top three", value: summary.podiums },
      ]}
    />
  )}
  <NoteBox regattaId={regatta.id} event="" note={notes[""]} canEdit={canNote} back={back} />
  {events.length === 0 && <p class="card">No {club.name} boats found at this regatta.</p>}
  {events.map(({ event, fieldSize, boats }) => (
    <section class="card">
      <h2>
        <a
          class="plain"
          href={`/event?${new URLSearchParams({ name: eventKey(event.name, settings), year })}`}
        >
          {event.name}
        </a>
      </h2>
      <p class="muted">
        Event {event.num}
        {event.start && ` · ${formatStart(event.start)}`} · {fieldSize} crews placed
      </p>
      <BoatList
        boats={boats}
        fieldSize={fieldSize}
        clubName={club.name}
        courseLengthM={venue?.courseLengthM}
      />
      <NoteBox
        regattaId={regatta.id}
        event={eventKey(event.name, settings)}
        note={notes[eventKey(event.name, settings)]}
        canEdit={canNote}
        back={back}
      />
    </section>
  ))}
</Base>
