---
import Base from "../layouts/Base.astro";
import { clubEvents, clubSummary } from "../lib/club-view.js";
import { loadContext } from "../lib/context.js";
import { formatDate } from "../lib/format.js";
import { regattaYear } from "../lib/history.js";

const { records, club } = await loadContext();
const regattas = records
  .map(({ regatta }) => ({ regatta, summary: clubSummary(clubEvents(regatta, club)) }))
  .sort((a, b) => b.regatta.date.localeCompare(a.regatta.date));
const years = [...new Set(regattas.map((r) => regattaYear(r.regatta)))];
---

<Base title="Season">
  {regattas.length === 0 && (
    <>
      <h1>Season</h1>
      <p class="card">
        No regattas yet.
        {Astro.locals.role === "admin" ? (
          <a href="/admin">Add one from its CrewTimer link.</a>
        ) : (
          "A club admin adds them after each race weekend."
        )}
      </p>
    </>
  )}
  {years.map((year) => (
    <section>
      <h1>{year}</h1>
      {regattas
        .filter((r) => regattaYear(r.regatta) === year)
        .map(({ regatta, summary }) => (
          <a class="card regatta" href={`/regatta/${regatta.id}`}>
            <h2>{regatta.title}</h2>
            <p class="muted">{formatDate(regatta.date)}</p>
            <p>
              {summary.boats === 0
                ? `No ${club.name} boats found`
                : `${summary.boats} boats · ${summary.wins} wins · ${summary.podiums} top three`}
            </p>
          </a>
        ))}
    </section>
  ))}
</Base>

<style>
  .regatta {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .regatta p {
    margin: 2px 0 0;
  }
</style>
