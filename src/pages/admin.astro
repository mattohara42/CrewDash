---
import Base from "../layouts/Base.astro";
import { nearMatches } from "../lib/club-view.js";
import { club as baseClub } from "../lib/config.js";
import { loadContext } from "../lib/context.js";
import { regattaDates } from "../crewtimer/normalize.js";
import { formatDates } from "../lib/format.js";
import { seriesKey, seriesName, suggestSeries } from "../lib/history.js";
import { speedSummary } from "../lib/speed.js";
import { NEW_VENUE } from "../lib/venues.js";

const error = Astro.url.searchParams.get("error");
const { store, records, settings, club } = await loadContext();
const venueData = await store.getVenues();
const regattas = records
  .map((record) => ({
    ...record,
    near: nearMatches(record.regatta, club),
    speed: speedSummary(record, club.timezone),
    venueId: venueData.seriesVenue[seriesKey(seriesName(record))] ?? "",
  }))
  .sort((a, b) => b.regatta.date.localeCompare(a.regatta.date));
const merges = Object.entries(settings.eventAliases).sort(([a], [b]) => a.localeCompare(b));
---

<Base title="Admin">
  <h1>Admin</h1>
  <p>
    <a href="/admin/venues">Venues and club tips</a> ·{" "}
    <a href="/admin/blades">Other clubs' blades</a>
  </p>
  {error && <p class="card notice">{error}</p>}

  <form method="post" action="/api/admin/regattas" class="card">
    <p>
      <label for="link">CrewTimer link or regatta ID</label>
      <input
        id="link"
        name="link"
        type="text"
        placeholder="https://www.crewtimer.com/regatta/r16329"
        required
      />
    </p>
    <button type="submit">Add or refresh regatta</button>
  </form>

  <h2>Regattas</h2>
  {regattas.length === 0 && <p class="muted">None yet.</p>}
  {regattas.map((record) => (
    <div class="card">
      <a href={`/regatta/${record.regatta.id}`}>{record.regatta.title}</a>
      <p class="muted">
        {formatDates(regattaDates(record.regatta))} · {record.regatta.id} · fetched{" "}
        {new Date(record.fetchedAt).toISOString().slice(0, 16).replace("T", " ")} UTC
      </p>
      {record.speed.events > 0 && (
        <p class="muted small">
          Results speed, over {record.speed.events} events: first result a median of{" "}
          {record.speed.firstMin ?? "?"} min after the start, all results{" "}
          {record.speed.allMin ?? "?"} min.
        </p>
      )}
      {record.near.map((name) => (
        <form method="post" action="/api/admin/aliases" class="row">
          <span class="notice-text">Not counted: {name}</span>
          <input type="hidden" name="name" value={name} />
          <input type="hidden" name="back" value="/admin" />
          <button type="submit" class="secondary">
            Count as {club.name}
          </button>
        </form>
      ))}
      <form method="post" action="/api/admin/series" class="settings">
        <input type="hidden" name="id" value={record.regatta.id} />
        <input type="hidden" name="back" value="/admin" />
        <label>
          Series
          <input
            type="text"
            name="series"
            value={record.series ?? ""}
            placeholder={suggestSeries(record.regatta.title)}
          />
        </label>
        <p class="muted small">
          Compared with: {seriesName(record)}. Leave blank to use the suggested name.
        </p>
        <label>
          Entries page (optional)
          <input
            type="url"
            name="registration"
            value={record.links?.registration ?? ""}
            placeholder="RegattaCentral or Streamline link"
          />
        </label>
        <label>
          Regatta website (optional)
          <input
            type="url"
            name="website"
            value={record.links?.website ?? ""}
            placeholder="https://"
          />
        </label>
        <label>
          Venue
          <select name="venue">
            <option value="">No venue</option>
            {venueData.venues.map((v) => (
              <option value={v.id} selected={record.venueId === v.id}>
                {v.name}
              </option>
            ))}
            <option value={NEW_VENUE}>New venue…</option>
          </select>
        </label>
        <p class="muted small">
          Applies to every year of {seriesName(record)}.{" "}
          {record.venueId && <a href={`/venue?id=${record.venueId}`}>See the venue page</a>}
        </p>
        <div class="row">
          <button type="submit">Save</button>
          <button
            type="submit"
            formaction="/api/admin/regattas"
            name="link"
            value={record.regatta.id}
            class="secondary"
            formnovalidate
          >
            Refresh now
          </button>
        </div>
      </form>
    </div>
  ))}

  <h2>Names counted as {club.name}</h2>
  <div class="card">
    <p class="muted">From club.json: {baseClub.aliases.join(", ")}</p>
    {settings.extraAliases.length === 0 && <p class="muted">No extra names added here.</p>}
    {settings.extraAliases.map((name) => (
      <form method="post" action="/api/admin/aliases" class="row">
        <span>{name}</span>
        <input type="hidden" name="name" value={name} />
        <input type="hidden" name="action" value="remove" />
        <input type="hidden" name="back" value="/admin" />
        <button type="submit" class="secondary">
          Remove
        </button>
      </form>
    ))}
  </div>

  <h2>Grouped events</h2>
  <div class="card">
    {merges.length === 0 && (
      <p class="muted">None. Group renamed events from a regatta's year-over-year page.</p>
    )}
    {merges.map(([from, into]) => (
      <form method="post" action="/api/admin/event-aliases" class="row">
        <span>
          {from} → {into}
        </span>
        <input type="hidden" name="from" value={from} />
        <input type="hidden" name="action" value="remove" />
        <input type="hidden" name="back" value="/admin" />
        <button type="submit" class="secondary">
          Undo
        </button>
      </form>
    ))}
  </div>
</Base>

<style>
  .notice-text {
    color: var(--warn);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 8px 12px;
    margin: 8px 0;
  }
  .row > span {
    flex: 1 1 200px;
  }
  .settings label {
    display: block;
    margin-top: 8px;
  }
  .small {
    font-size: 0.85rem;
    margin-top: 0;
  }
</style>
