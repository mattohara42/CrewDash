---
import VenueDetails from "../components/VenueDetails.astro";
import Base from "../layouts/Base.astro";
import { regattaDates } from "../crewtimer/normalize.js";
import { club } from "../lib/config.js";
import { blobsStore } from "../lib/store.js";
import { localDate } from "../lib/today.js";
import { regattasAtVenue } from "../lib/venues.js";

// Every venue in full, so families don't have to tap through. The venue of today's or the
// next regatta comes first, then the rest by name.
const store = blobsStore();
const [records, data] = await Promise.all([store.list(), store.getVenues()]);
const today = localDate(new Date(), club.timezone);
const venues = data.venues
  .map((venue) => {
    const regattas = regattasAtVenue(records, data, venue.id);
    // The first race day of a regatta here that hasn't finished yet.
    const next = regattas
      .filter((r) => regattaDates(r.regatta).at(-1)! >= today)
      .map((r) => r.regatta.date)
      .sort()[0];
    return { venue, regattas, next };
  })
  .sort(
    (a, b) =>
      (a.next ?? "9999").localeCompare(b.next ?? "9999") ||
      a.venue.name.localeCompare(b.venue.name),
  );
const isAdmin = Astro.locals.role === "admin";
---

<Base title="Venues">
  <h1>Venues</h1>
  <p class="muted">Where we race: maps, parking and tips for families.</p>
  {venues.length === 0 && (
    <p class="card muted">
      No venues yet. {isAdmin ? <a href="/admin/venues">Add one.</a> : "A club admin adds them."}
    </p>
  )}
  {venues.length > 1 && (
    <nav class="tabs" aria-label="Venues" data-tabs>
      {venues.map(({ venue }, i) => (
        <a href={`#${venue.id}`} aria-current={i === 0 ? "true" : undefined}>
          {venue.name}
        </a>
      ))}
    </nav>
  )}
  <div class="track" data-track>
    {venues.map(({ venue, regattas, next }, i) => (
      <section class="venue" id={venue.id} aria-label={venue.name}>
        {next && <p class="eyebrow">{next <= today ? "Racing today" : "Next regatta"}</p>}
        <h2>
          <a class="plain" href={`/venue?id=${venue.id}`}>
            {venue.name}
          </a>
        </h2>
        {venues.length > 1 && (
          <p class="muted small">
            {i + 1} of {venues.length} · swipe for more
          </p>
        )}
        <VenueDetails venue={venue} regattas={regattas} heading="h3" />
      </section>
    ))}
  </div>
  {isAdmin && venues.length > 0 && (
    <p>
      <a href="/admin/venues">Edit venues</a>
    </p>
  )}
</Base>

<script>
  // The venues sit side by side and snap one at a time. The tabs follow the scroll, and a
  // tapped tab scrolls its venue into view. Without scripts the tabs are plain anchors.
  const track = document.querySelector<HTMLElement>("[data-track]");
  const tabs = [...document.querySelectorAll<HTMLAnchorElement>("[data-tabs] a")];
  if (track && tabs.length > 0) {
    const slides = [...track.children] as HTMLElement[];
    const show = (i: number) => {
      tabs.forEach((t, j) => t.toggleAttribute("aria-current", i === j));
      tabs[i]?.scrollIntoView({ block: "nearest", inline: "nearest" });
    };
    tabs.forEach((tab, i) =>
      tab.addEventListener("click", (e) => {
        e.preventDefault();
        track.scrollTo({ left: slides[i]!.offsetLeft - track.offsetLeft, behavior: "smooth" });
        history.replaceState(null, "", tab.hash);
      }),
    );
    let pending = 0;
    track.addEventListener("scroll", () => {
      cancelAnimationFrame(pending);
      pending = requestAnimationFrame(() => {
        // The slide whose left edge is nearest the track's.
        const at = (s: HTMLElement) => Math.abs(s.offsetLeft - track.offsetLeft - track.scrollLeft);
        show(slides.indexOf(slides.reduce((a, b) => (at(b) < at(a) ? b : a))));
      });
    });
    // Opened from a link to one venue: start on it.
    const start = slides.findIndex((s) => `#${s.id}` === location.hash);
    if (start > 0) track.scrollLeft = slides[start]!.offsetLeft - track.offsetLeft;
  }
</script>

<style>
  .tabs {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    margin: 8px 0 12px;
    padding-bottom: 4px;
    scrollbar-width: none;
  }
  .tabs a {
    flex: 0 0 auto;
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid var(--border);
    text-decoration: none;
    font-size: 0.9rem;
    color: inherit;
  }
  .tabs a[aria-current] {
    background: var(--brand);
    border-color: var(--brand);
    color: #ffffff;
    font-weight: 700;
  }
  .track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    gap: 16px;
  }
  .track::-webkit-scrollbar,
  .tabs::-webkit-scrollbar {
    display: none;
  }
  .venue {
    flex: 0 0 100%;
    min-width: 0;
    scroll-snap-align: start;
  }
  .small {
    font-size: 0.85rem;
    margin-top: 0;
  }
</style>
