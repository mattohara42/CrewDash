---
import type { ClubBoat } from "../lib/club-view.js";
import { lineupKey, type RegattaLineups } from "../lib/lineups.js";
import LineupBox from "./LineupBox.astro";
import {
  formatGap,
  formatMargin,
  formatTime,
  ordinal,
  pacePer500,
  statusLabel,
} from "../lib/format.js";

interface Props {
  boats: ClubBoat[];
  fieldSize: number;
  clubName: string;
  // From the venue, when known. Pace only makes sense on one course.
  courseLengthM?: number | null;
  // On regatta pages: each boat's lineup, editable by coaches.
  lineups?: {
    regattaId: string;
    eventNum: string;
    byKey: RegattaLineups;
    canEdit: boolean;
    back: string;
  };
}

// Exhibition boats never have a place, so their status label already marks them.
const { boats, fieldSize, clubName, courseLengthM, lineups } = Astro.props;

// "1.2 s behind 2nd · 3.4 s off third · beat 8 crews"
function analysis(boat: ClubBoat): string {
  const parts: string[] = [];
  if (boat.wonByMs !== null) parts.push(`won by ${formatGap(boat.wonByMs)}`);
  if (boat.gapUpMs !== null && boat.entry.place !== null) {
    parts.push(`${formatGap(boat.gapUpMs)} behind ${ordinal(boat.entry.place - 1)}`);
  }
  if (boat.offThirdMs !== null) parts.push(`${formatGap(boat.offThirdMs)} off third`);
  if (boat.beaten) parts.push(`beat ${boat.beaten} ${boat.beaten === 1 ? "crew" : "crews"}`);
  return parts.join(" · ");
}
// The place is always written out, so the medal color is never the only cue.
const MEDALS: Record<number, string> = { 1: "gold", 2: "silver", 3: "bronze" };
---

<ul class="boats">
  {boats.map((boat) => {
    const { entry, marginMs, wouldHavePlaced } = boat;
    const summary = analysis(boat);
    return (
      <li>
        <div class="result">
          {entry.place !== null ? (
            <span>
              <span class={`medal ${MEDALS[entry.place] ?? ""}`}>{ordinal(entry.place)}</span>{" "}
              <span class="muted">of {fieldSize}</span>
            </span>
          ) : (
            <a
              class="term"
              href={`/guide#${entry.status === "exhibition" ? "exhibition" : "statuses"}`}
            >
              <strong>{statusLabel(entry)}</strong>
            </a>
          )}
          {entry.adjustedTimeMs !== null && <span>{formatTime(entry.adjustedTimeMs)}</span>}
          {marginMs !== null && (
            <a class="term muted" href="/guide#margin">
              {formatMargin(marginMs)}
            </a>
          )}
        </div>
        {summary && <div class="analysis">{summary}</div>}
        <div class="muted">
          Bow {entry.bow}
          {entry.stroke && ` · Stroke ${entry.stroke}`}
          {entry.crew !== clubName && ` · ${entry.crew}`}
          {courseLengthM && entry.rawTimeMs !== null && (
            <>
              {" · "}
              <a class="term" href="/guide#pace">
                {pacePer500(entry.rawTimeMs, courseLengthM)} /500 m
              </a>
            </>
          )}
        </div>
        {wouldHavePlaced !== null && (
          <div class="muted">
            <a class="term" href="/guide#would-have-placed">
              Would have placed
            </a>{" "}
            {ordinal(wouldHavePlaced)} (unofficial; exhibition boats can't medal)
          </div>
        )}
        {entry.penalties.length > 0 && (
          <div class="muted">
            <a class="term" href="/guide#penalties">
              Penalties
            </a>
            :{" "}
            {entry.penalties
              .map((p) => (p.seconds !== null ? `${p.code} +${p.seconds}s` : p.code))
              .join(", ")}
          </div>
        )}
        {entry.handicapSeconds !== null &&
          entry.handicapSeconds !== 0 &&
          entry.rawTimeMs !== null && (
            <div class="muted">
              Raw time {formatTime(entry.rawTimeMs)},{" "}
              <a class="term" href="/guide#handicap">
                handicap
              </a>{" "}
              {entry.handicapSeconds}s
            </div>
          )}
        {lineups && (
          <LineupBox
            regattaId={lineups.regattaId}
            eventNum={lineups.eventNum}
            bow={entry.bow}
            lineup={lineups.byKey[lineupKey(lineups.eventNum, entry.bow)]}
            canEdit={lineups.canEdit}
            back={lineups.back}
          />
        )}
      </li>
    );
  })}
</ul>

<style>
  .boats {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
  }
  li {
    padding: 8px 0;
    border-top: 1px solid var(--border);
  }
  /* Terms link to the Rowing 101 page. A dotted underline keeps them quieter than links. */
  .term {
    color: inherit;
    text-decoration: underline dotted;
    text-underline-offset: 3px;
  }
  .analysis {
    font-size: 0.92rem;
  }
  .result {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    align-items: baseline;
  }
</style>
