{
  "name": "crewdash",
  "version": "0.1.0",
  "private": true,
  "description": "Find your rower. Track your team.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
